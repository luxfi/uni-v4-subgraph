{
  "name": "lux-v4-subgraph",
  "version": "1.0.0",
  "repository": "https://github.com/luxfi/uni-v4-subgraph",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "build": "run-s codegen && graph build",
    "build:docker": "docker build -t matchstick .",
    "buildonly": "graph build",
    "deploy:alchemy": "graph deploy --node https://subgraphs.alchemy.com/api/subgraphs/deploy --ipfs https://ipfs.satsuma.xyz",
    "codegen": "graph codegen --output-dir src/types/",
    "test": "graph test -d",
    "test:no-tty": "docker run -i --rm --mount type=bind,source=$INIT_CWD,target=/matchstick matchstick",
    "prepare": "husky install",
    "generate-subgraph": "ts-node scripts/generate-subgraph.ts",
    "deploy-lux": "graph deploy lux/uniswap-v4 --ipfs http://graph-ipfs.lux-mainnet.svc:5001 --node http://graph-node.lux-mainnet.svc:8020",
    "deploy-lux-testnet": "graph deploy lux-testnet/uniswap-v4 --ipfs http://graph-ipfs.lux-testnet.svc:5001 --node http://graph-node.lux-testnet.svc:8020",
    "deploy-lux-devnet": "graph deploy lux-devnet/uniswap-v4 --ipfs http://graph-ipfs.lux-devnet.svc:5001 --node http://graph-node.lux-devnet.svc:8020",
    "deploy-zoo": "graph deploy zoo/uniswap-v4 --ipfs http://graph-ipfs.lux-mainnet.svc:5001 --node http://graph-node.lux-mainnet.svc:8020",
    "deploy-zoo-testnet": "graph deploy zoo-testnet/uniswap-v4 --ipfs http://graph-ipfs.lux-testnet.svc:5001 --node http://graph-node.lux-testnet.svc:8020",
    "create-next": "graph create liquidity/uniswap-v4 --node http://graph-node.chain.svc.cluster.local:8020",
    "deploy-next": "graph deploy liquidity/uniswap-v4 --ipfs http://ipfs.chain.svc.cluster.local:5001 --node http://graph-node.chain.svc.cluster.local:8020"
  },
  "devDependencies": {
    "@graphprotocol/graph-cli": "^0.98.1",
    "@graphprotocol/graph-ts": "^0.38.2",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@uniswap/eslint-config": "^1.2.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "matchstick-as": "^0.6.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "graph": "^0.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "yaml": "^2.9.0"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
